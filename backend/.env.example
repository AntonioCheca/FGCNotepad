### Symfony runtime ###
APP_ENV=dev
APP_RUNTIME_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-development-secret

### Database ###
# Docker defaults use fgc_user/fgc_pass/fgc_db on the postgres service.
# Local Windows development commonly uses 127.0.0.1:5432.
POSTGRES_USER=fgc_user
POSTGRES_PASSWORD=fgc_pass
POSTGRES_DB=fgc_db
DATABASE_URL="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@127.0.0.1:5432/$POSTGRES_DB"

### Symfony defaults ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
SYMFONY_TRUSTED_HOSTS=
SYMFONY_TRUST_X_SENDFILE_TYPE_HEADER=
SYMFONY_TRUSTED_PROXIES=
TEST_TOKEN=
APP_RUNTIME_MODE=
SYMFONY_IDE=

### Replay Lab storage ###
REPLAY_STORAGE_ADAPTER=local
REPLAY_STORAGE_LOCAL_ROOT=%kernel.project_dir%/var/replay-storage
REPLAY_IMPORT_DIRECTORY=%kernel.project_dir%/var/replay-imports
REPLAY_MAX_SIZE_BYTES=3221225472
REPLAY_MAX_DURATION_SECONDS=600
REPLAY_MAX_TEMPORARY_REPLAYS_PER_USER=20
REPLAY_MAX_TEMPORARY_STORAGE_BYTES_PER_USER=1073741824
REPLAY_RETENTION_DAYS=14
REPLAY_CLIP_MAX_DURATION_SECONDS=10
REPLAY_MAX_CLIPS_PER_USER=500
REPLAY_MAX_CLIP_STORAGE_BYTES_PER_USER=1073741824
REPLAY_ORPHAN_CLIP_RETENTION_DAYS=1
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

### Replay Lab production S3 target ###
# Keep REPLAY_STORAGE_ADAPTER=local until an S3 adapter is implemented and wired.
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_REPLAY_PREFIX=replays
AWS_S3_CLIP_PREFIX=clips
