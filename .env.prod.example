# Copy this file to .env.prod on the production server. Do not commit .env.prod.

### Symfony runtime ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-generate-a-real-secret

### Database ###
POSTGRES_DB=fgc_db
POSTGRES_USER=fgc_user
POSTGRES_PASSWORD=change-me-generate-a-real-password
DATABASE_URL="postgresql://fgc_user:change-me-generate-a-real-password@postgres:5432/fgc_db?serverVersion=15&charset=utf8"

### Authentication ###
REGISTRATION_ENABLED=false

### Frontend ###
NEXT_PUBLIC_API_URL=/api
NEXT_SERVER_API_URL=https://fightinggametheory.com/api

### Public domain ###
# Change this value when the production domain is final.
APP_PUBLIC_DOMAIN=fightinggametheory.com

### HTTP/CORS ###
# Same-domain production should not need CORS for frontend -> backend calls, but Symfony still requires this variable.
CORS_ALLOW_ORIGIN='^https://(www\.)?fightinggametheory\.com$'

### Symfony integrations ###
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
SYMFONY_TRUSTED_HOSTS='^(www\.)?fightinggametheory\.com$'
SYMFONY_TRUST_X_SENDFILE_TYPE_HEADER=
SYMFONY_TRUSTED_PROXIES=
TEST_TOKEN=
APP_RUNTIME_MODE=
SYMFONY_IDE=

### Replay Lab local storage ###
REPLAY_STORAGE_ADAPTER=local
REPLAY_STORAGE_LOCAL_ROOT=/var/www/html/var/replay-storage
REPLAY_IMPORT_DIRECTORY=/var/www/html/var/replay-imports
REPLAY_MAX_SIZE_BYTES=3221225472
REPLAY_MAX_DURATION_SECONDS=600
REPLAY_MAX_TEMPORARY_REPLAYS_PER_USER=20
REPLAY_MAX_TEMPORARY_STORAGE_BYTES_PER_USER=1073741824
REPLAY_RETENTION_DAYS=14
REPLAY_CLIP_MAX_DURATION_SECONDS=10
REPLAY_MAX_CLIPS_PER_USER=500
REPLAY_MAX_CLIP_STORAGE_BYTES_PER_USER=1073741824
REPLAY_ORPHAN_CLIP_RETENTION_DAYS=1

### Server-side Replay Lab export only ###
# Browser export does not require server ffmpeg. Server-side export requires installing ffmpeg in the backend image.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

### Future S3 target ###
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_REPLAY_PREFIX=replays
AWS_S3_CLIP_PREFIX=clips
