parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        -
            identifier: property.onlyWritten
        -
            # KernelBrowser responses change between requests, but PHPStan treats repeated getStatusCode() calls as the same value.
            identifier: staticMethod.alreadyNarrowedType
            path: tests/*
        -
            identifier: property.onlyRead
            path: src/Entity/NeutralObservation*.php
        -
            identifier: doctrine.columnType
            path: src/Entity/*
        -
            identifier: doctrine.associationType
            path: src/Entity/*
