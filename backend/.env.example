### Symfony runtime ###
APP_ENV=dev
APP_RUNTIME_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-development-secret

### Database ###
# Docker defaults use fgc_user/fgc_pass/fgc_db on the postgres service.
# Local Windows development commonly uses 127.0.0.1:5432.
POSTGRES_USER=fgc_user
POSTGRES_PASSWORD=fgc_pass
POSTGRES_DB=fgc_db
DATABASE_URL="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@127.0.0.1:5432/$POSTGRES_DB"

### Authentication ###
# Generate local JWT keys with make local-create-jwt-keys or make create-jwt-keys.
DISABLE_JWT=false
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me-jwt-passphrase

### Symfony defaults ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
SYMFONY_TRUSTED_HOSTS=
SYMFONY_TRUST_X_SENDFILE_TYPE_HEADER=
SYMFONT_TRUSTED_PROXIES=
TEST_TOKEN=
APP_RUNTIME_MODE=
SYMFONY_IDE=
