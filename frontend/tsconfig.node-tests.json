{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".node-test",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": ["node_modules", ".next"]
}
