### Symfony test runtime ###
APP_ENV=test
KERNEL_CLASS='App\Kernel'
APP_SECRET='change-me-test-secret'
SYMFONY_DEPRECATIONS_HELPER=999999

### Test database ###
# Symfony appends _test to the database name through doctrine.yaml when APP_ENV=test.
# This example resolves to fgc_db_test for PHPUnit.
POSTGRES_USER=fgc_user
POSTGRES_PASSWORD=fgc_pass
POSTGRES_DB=fgc_db
DATABASE_URL="postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@127.0.0.1:5432/$POSTGRES_DB"

PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

### Replay Lab storage ###
REPLAY_STORAGE_ADAPTER=local
REPLAY_STORAGE_LOCAL_ROOT=%kernel.project_dir%/var/replay-storage-test
REPLAY_IMPORT_DIRECTORY=%kernel.project_dir%/var/replay-imports-test
REPLAY_MAX_SIZE_BYTES=3221225472
REPLAY_MAX_DURATION_SECONDS=600
REPLAY_MAX_TEMPORARY_REPLAYS_PER_USER=20
REPLAY_MAX_TEMPORARY_STORAGE_BYTES_PER_USER=1073741824
REPLAY_RETENTION_DAYS=14
REPLAY_CLIP_MAX_DURATION_SECONDS=10
REPLAY_MAX_CLIPS_PER_USER=500
REPLAY_MAX_CLIP_STORAGE_BYTES_PER_USER=1073741824
REPLAY_ORPHAN_CLIP_RETENTION_DAYS=1
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_REPLAY_PREFIX=replays
AWS_S3_CLIP_PREFIX=clips
