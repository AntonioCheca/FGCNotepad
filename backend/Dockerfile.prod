FROM php:8.2-fpm

ENV APP_ENV=prod
ENV APP_DEBUG=0
ENV COMPOSER_ALLOW_SUPERUSER=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    unzip \
    zip \
    curl \
    libpq-dev \
    python3 \
    python3-pip \
    python3-venv \
    && docker-php-ext-install pdo pdo_pgsql \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2.6 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY backend/composer.json backend/composer.lock backend/symfony.lock ./
RUN composer install --no-dev --prefer-dist --no-progress --no-interaction --no-scripts --optimize-autoloader

COPY backend/python_requirements.txt ./python_requirements.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r python_requirements.txt

COPY backend/ ./
RUN composer dump-autoload --no-dev --optimize --no-interaction \
    && mkdir -p var/cache var/log config/jwt \
    && chown -R www-data:www-data var config/jwt

ENV PATH="/opt/venv/bin:$PATH"

USER www-data

EXPOSE 9000
CMD ["php-fpm"]
